# Copiar como ".env" dentro de la carpeta api/. Nunca se sube a Git.

NODE_ENV=development
PUERTO=3000

# Mismo usuario y contrasena que el .env de docker-compose.
URL_POSTGRES=postgresql://colectivos_app:cambiar-por-una-contrasena-larga@localhost:5432/colectivos

# Peticiones por minuto que acepta la API desde una misma IP. Dejar en 100.
# Solo se sube (por ejemplo a 5000) mientras corre la prueba de carga con k6.
LIMITE_GENERAL_POR_MINUTO=100

# Secreto para firmar los tokens. Minimo 32 caracteres aleatorios.
# Generar uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRETO_JWT=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# MongoDB: mismo usuario y contrasena que MONGO_USUARIO / MONGO_CONTRASENA del .env de Docker.
URL_MONGO=mongodb://colectivos_admin:cambiar-por-otra-contrasena-larga@localhost:27017/?authSource=admin

# Opcional. Solo si la web corre en otro puerto durante el desarrollo, por ejemplo:
# ORIGEN_WEB=http://localhost:5173
