# Configuracion del servidor. NO se copia a mano: se crea con
#   bash generar-env.sh
# que pone contrasenas y secreto aleatorios. Este archivo solo muestra
# que variables existen. El .env real NUNCA se sube a Git.

DOMINIO=colectivos-inacap.eastus.cloudapp.azure.com
POSTGRES_USUARIO=colectivos_app
POSTGRES_CONTRASENA=se-genera-sola
MONGO_USUARIO=colectivos_admin
MONGO_CONTRASENA=se-genera-sola
SECRETO_JWT=se-genera-solo
