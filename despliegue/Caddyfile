# Caddy: puerta de entrada del servidor.
# Con un dominio real obtiene y renueva solo el certificado HTTPS (Let's
# Encrypt) y redirige HTTP a HTTPS. Con DOMINIO=localhost usa un certificado
# local, que es lo que hacen las pruebas automaticas.

{$DOMINIO} {
	encode zstd gzip

	# La API: todo lo que empieza con /api. Caddy agrega X-Forwarded-For y
	# la API confia en un salto de proxy para leer la IP real del cliente.
	handle /api/* {
		reverse_proxy api:3000
	}

	# La web: archivos estaticos. Cualquier otra ruta vuelve a index.html,
	# porque la aplicacion web resuelve sus propias rutas en el navegador.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
